# Systemd service unit file for the DuckierVPN daemon (CLI package)

[Unit]
Description=DuckierVPN daemon
Before=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=20

[Service]
Type=simple
Restart=always
RestartSec=1
ExecStart=/usr/bin/duckiervpn-daemon
Environment="DUCKIER_RESOURCE_DIR=/usr/share/duckiervpn/"
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
RuntimeDirectory=duckiervpn
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
