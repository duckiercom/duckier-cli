# syntax=docker/dockerfile:1.3
# Alpine-based builder for Duckier CLI Linux packages (x86_64 + aarch64)
#
# Cross-compiles both architectures in a single build using musl.
# Docker context is the vpn_cli/ directory.
FROM --platform=linux/amd64 alpine:latest

# Build deps
RUN apk add --no-cache \
    build-base \
    protoc \
    protobuf-dev \
    dpkg \
    rpm \
    curl \
    findutils \
    grep

# Rust stable
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Build targets (musl = static linking, works on any Linux)
RUN rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl

# aarch64 musl cross-compiler from musl.cc
RUN curl -L https://musl.cc/aarch64-linux-musl-cross.tgz | tar xz -C /opt/
ENV PATH="/opt/aarch64-linux-musl-cross/bin:${PATH}"

# Configure cargo for aarch64 cross-compilation
RUN printf '[target.aarch64-unknown-linux-musl]\nlinker = "aarch64-linux-musl-gcc"\n' \
    >> /root/.cargo/config.toml

WORKDIR /app

# Copy CLI source + proto file
COPY Cargo.toml Cargo.lock build.rs config.toml vpn.proto ./vpn_cli/
COPY src/ ./vpn_cli/src/

# Copy pre-downloaded daemon binaries (both archs, placed by build script)
COPY binaries/ ./binaries/

# Copy packaging scripts
COPY scripts/packaging/ ./packaging/

# ── Build CLI for both architectures ──────────────────────────────
WORKDIR /app/vpn_cli
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo build --release --locked --target x86_64-unknown-linux-musl && \
    cargo build --release --locked --target aarch64-unknown-linux-musl && \
    mkdir -p /output && \
    cp target/x86_64-unknown-linux-musl/release/duckier-cli /output/duckier-cli-amd64 && \
    cp target/aarch64-unknown-linux-musl/release/duckier-cli /output/duckier-cli-arm64 && \
    strip /output/duckier-cli-amd64

# Strip arm64 binary with cross-strip
RUN aarch64-linux-musl-strip /output/duckier-cli-arm64

# Copy daemon binaries to output
RUN cp /app/binaries/duckiervpn-daemon-amd64 /output/ && \
    cp /app/binaries/duckiervpn-daemon-arm64 /output/ && \
    chmod 755 /output/duckiervpn-daemon-*

# Extract version from Cargo.toml for packaging
RUN grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)"/\1/' > /output/VERSION

# ── DEB packages (amd64 + arm64) ─────────────────────────────────
RUN VERSION=$(cat /output/VERSION) && \
    for ARCH in amd64 arm64; do \
        PKG_DIR="/tmp/deb/duckier-cli_${VERSION}_${ARCH}" && \
        mkdir -p "${PKG_DIR}/DEBIAN" \
                 "${PKG_DIR}/usr/bin" \
                 "${PKG_DIR}/usr/lib/systemd/system" && \
        cp "/output/duckier-cli-${ARCH}" "${PKG_DIR}/usr/bin/duckier-cli" && \
        cp "/output/duckiervpn-daemon-${ARCH}" "${PKG_DIR}/usr/bin/duckiervpn-daemon" && \
        cp /app/packaging/deb/duckiervpn-daemon.service "${PKG_DIR}/usr/lib/systemd/system/" && \
        chmod 755 "${PKG_DIR}/usr/bin/"* && \
        printf 'Package: duckier-cli\nVersion: %s\nArchitecture: %s\nMaintainer: Duckier <dev@duckier.com>\nDescription: DuckierVPN CLI — headless VPN client with daemon\n Command-line interface and daemon for DuckierVPN. Connects via WireGuard.\n Includes the VPN daemon service for headless/server deployments.\nSection: net\nPriority: optional\nHomepage: https://duckier.com\n' "${VERSION}" "${ARCH}" > "${PKG_DIR}/DEBIAN/control" && \
        cp /app/packaging/deb/preinstall.sh  "${PKG_DIR}/DEBIAN/preinst" && \
        cp /app/packaging/deb/postinstall.sh "${PKG_DIR}/DEBIAN/postinst" && \
        cp /app/packaging/deb/preremove.sh   "${PKG_DIR}/DEBIAN/prerm" && \
        cp /app/packaging/deb/postremove.sh  "${PKG_DIR}/DEBIAN/postrm" && \
        chmod 755 "${PKG_DIR}/DEBIAN/pre"* "${PKG_DIR}/DEBIAN/post"* && \
        dpkg-deb --build --root-owner-group "${PKG_DIR}" && \
        mkdir -p /output/deb && \
        mv "${PKG_DIR}.deb" /output/deb/ ; \
    done

# ── RPM packages (x86_64 + aarch64) ──────────────────────────────
RUN VERSION=$(cat /output/VERSION) && \
    for ARCH_PAIR in "x86_64:amd64" "aarch64:arm64"; do \
        RPM_ARCH="${ARCH_PAIR%%:*}" && \
        BIN_SUFFIX="${ARCH_PAIR##*:}" && \
        RPMROOT="/root/rpmbuild-${RPM_ARCH}" && \
        mkdir -p "${RPMROOT}/BUILD" "${RPMROOT}/RPMS" "${RPMROOT}/SOURCES" "${RPMROOT}/SPECS" "${RPMROOT}/SRPMS" && \
        cp "/output/duckier-cli-${BIN_SUFFIX}" "${RPMROOT}/SOURCES/duckier-cli" && \
        cp "/output/duckiervpn-daemon-${BIN_SUFFIX}" "${RPMROOT}/SOURCES/duckiervpn-daemon" && \
        cp /app/packaging/deb/duckiervpn-daemon.service "${RPMROOT}/SOURCES/" && \
        sed "s/__VERSION__/${VERSION}/" /app/packaging/rpm/duckier-cli.spec > "${RPMROOT}/SPECS/duckier-cli.spec" && \
        rpmbuild --define "_topdir ${RPMROOT}" --define "__strip /bin/true" --define "__brp_remove_la_files %{nil}" --target "${RPM_ARCH}" -bb "${RPMROOT}/SPECS/duckier-cli.spec" && \
        mkdir -p /output/rpm && \
        cp "${RPMROOT}/RPMS/${RPM_ARCH}/"*.rpm /output/rpm/ ; \
    done

# ── Generic tarballs (for Arch packaging) ─────────────────────────
RUN for ARCH_PAIR in "x86_64:amd64" "aarch64:arm64"; do \
        TAR_ARCH="${ARCH_PAIR%%:*}" && \
        BIN_SUFFIX="${ARCH_PAIR##*:}" && \
        STAGE="/tmp/generic-${TAR_ARCH}" && \
        mkdir -p "${STAGE}/usr/bin" "${STAGE}/usr/lib/systemd/system" && \
        cp "/output/duckier-cli-${BIN_SUFFIX}" "${STAGE}/usr/bin/duckier-cli" && \
        cp "/output/duckiervpn-daemon-${BIN_SUFFIX}" "${STAGE}/usr/bin/duckiervpn-daemon" && \
        cp /app/packaging/deb/duckiervpn-daemon.service "${STAGE}/usr/lib/systemd/system/" && \
        tar -czf "/output/duckier-cli-linux-${TAR_ARCH}.tar.gz" -C "${STAGE}" . ; \
    done

# Output layout:
#   /output/deb/duckier-cli_VERSION_amd64.deb
#   /output/deb/duckier-cli_VERSION_arm64.deb
#   /output/rpm/duckier-cli-VERSION-1.x86_64.rpm
#   /output/rpm/duckier-cli-VERSION-1.aarch64.rpm
#   /output/duckier-cli-linux-x86_64.tar.gz
#   /output/duckier-cli-linux-aarch64.tar.gz
